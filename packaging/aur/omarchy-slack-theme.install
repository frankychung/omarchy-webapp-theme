post_install() {
  cat <<'EOF'

  The native-messaging host is registered system-wide, but the per-user bits
  (the omarchy theme-set hook and the browser --load-extension flag) can't be
  installed from a package. Finish setup as your normal user:

      omarchy-slack-theme-setup

  Then fully quit your browser -- closing the window isn't enough:

      pkill brave    # or chromium / google-chrome-stable

  Open app.slack.com and switch omarchy themes; Slack should follow.

EOF
}

post_upgrade() {
  cat <<'EOF'

  Restart your browser to pick up the new version. If you upgraded from a
  git-checkout install, run 'omarchy-slack-theme-setup' once so the hook and
  --load-extension flag point at /usr/share/omarchy-slack-theme instead of your
  old clone -- then remove the clone's wiring with './install.sh --uninstall'.

EOF
}

pre_remove() {
  cat <<'EOF'

  Removing the package leaves the per-user wiring behind. To clean it up, run
  this BEFORE the package disappears:

      omarchy-slack-theme-setup --uninstall

EOF
}
