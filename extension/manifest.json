{
  "manifest_version": 3,
  "name": "Omarchy Web App Theme",
  "version": "0.3.0",
  "description": "Make web apps (Slack, WhatsApp, ...) follow the current Omarchy theme: palette, light/dark, and accent.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "*://app.slack.com/*",
    "*://*.slack.com/*",
    "*://web.whatsapp.com/*",
    "*://github.com/*",
    "*://gist.github.com/*",
    "*://linear.app/*",
    "*://*.linear.app/*",
    "*://discord.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.slack.com/*",
        "*://*.slack.com/*",
        "*://web.whatsapp.com/*",
        "*://github.com/*",
        "*://gist.github.com/*",
        "*://linear.app/*",
        "*://*.linear.app/*",
        "*://discord.com/*"
      ],
      "js": ["inject-prefers-color-scheme.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://app.slack.com/*",
        "*://*.slack.com/*",
        "*://web.whatsapp.com/*",
        "*://github.com/*",
        "*://gist.github.com/*",
        "*://linear.app/*",
        "*://*.linear.app/*",
        "*://discord.com/*"
      ],
      "js": [
        "omarchy-colors.js",
        "omarchy-surfaces.js",
        "omarchy-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://app.slack.com/*", "*://*.slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://github.com/*", "*://gist.github.com/*"],
      "js": ["github.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://linear.app/*", "*://*.linear.app/*"],
      "js": ["linear.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://discord.com/*"],
      "js": ["discord.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Omarchy Web App Theme"
  }
}
